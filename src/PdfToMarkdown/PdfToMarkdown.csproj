<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Tesseract 原生程式庫需要固定平台，統一使用 x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RootNamespace>PdfToMarkdown</RootNamespace>
    <AssemblyName>PdfToMarkdown</AssemblyName>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 讓未安裝 .NET Framework 4.8 Developer Pack 的機器也能建置 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfToMarkdown.Tests" />
  </ItemGroup>

</Project>
